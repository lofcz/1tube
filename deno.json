{
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window"]
  },
  "tasks": {
    "dev": "deno run --allow-all --watch src/cli.ts",
    "serve": "deno run --allow-all src/cli.ts",
    "play": "deno run --allow-all --watch src/cli.ts --dev --hmr --functions ./playground --port 3199",
    "play:workerd": "deno run --allow-all src/cli.ts --backend workerd --dev --hmr --functions ./playground --port 3199",
    "build": "deno run --allow-all src/cli.ts build",
    "test": "deno test --allow-all tests/"
  },
  "imports": {
    "@std/path": "jsr:@std/path@^1",
    "@std/assert": "jsr:@std/assert@^1",
    "hono": "npm:hono@4",
    "esbuild": "npm:esbuild@^0.28",
    "@deno/esbuild-plugin": "jsr:@deno/esbuild-plugin@^1.2",
    "@zip-js/zip-js": "jsr:@zip-js/zip-js@^2.8"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  },
  "nodeModulesDir": "auto",
  "allowScripts": {
    "allow": [],
    "deny": ["npm:protobufjs@7.5.4"]
  }
}
