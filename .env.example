# Supabase connection (required)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret -- must match the Supabase JWT secret for RLS compatibility
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# ScioBot / priprava backend
SCIOBOT_URL=http://localhost:44298
SCIOBOT_KEY=

# AI providers
GOOGLE_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
TAVILY_API_KEY=

# Gateway config
PORT=3100
FUNCTIONS_PATH=../sciobot-next/supabase/functions
# INTERNAL_KEY=00000000-0000-0000-0000-000000000000  # optional, random GUID is fine

# Optional: Sentry error tracking
# SENTRY_DSN=

# Optional: log function invocations to Supabase table
# LOG_TO_DB=true
