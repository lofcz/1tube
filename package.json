{
  "name": "1tube",
  "version": "0.5.1",
  "private": false,
  "description": "Self-hosted Supabase Edge Functions gateway on Bun, plus an ESLint plugin for consumers",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lofcz/1tube.git"
  },
  "homepage": "https://github.com/lofcz/1tube",
  "bugs": {
    "url": "https://github.com/lofcz/1tube/issues"
  },
  "exports": {
    "./edge": {
      "types": "./dist/edge.d.ts",
      "import": "./dist/edge.js",
      "default": "./dist/edge.js"
    },
    "./edge-caller": {
      "types": "./dist/edge-caller.d.ts",
      "import": "./dist/edge-caller.js",
      "default": "./dist/edge-caller.js"
    },
    "./warmup-client": {
      "types": "./dist/warmup-client.d.ts",
      "import": "./dist/warmup-client.js",
      "default": "./dist/warmup-client.js"
    },
    "./test": {
      "types": "./dist/test/node.d.ts",
      "bun": "./src/test/bun.ts",
      "import": "./dist/test/node.js",
      "default": "./dist/test/node.js"
    },
    "./eslint-plugin": "./eslint-plugin.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "1tube": "./scripts/npm-cli.js"
  },
  "files": [
    "eslint-plugin.js",
    "dist",
    "drizzle",
    "scripts/npm-cli.js",
    "src",
    "tsconfig.json",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun --watch src/cli.ts",
    "serve": "bun src/cli.ts",
    "play": "bun src/cli.ts --dev --hmr --functions ./playground --port 3199",
    "play:workerd": "bun src/cli.ts --backend workerd --dev --hmr --functions ./playground --port 3199",
    "build": "bun src/cli.ts build",
    "test": "bun test --timeout 60000",
    "build:edge": "bunx tsc --ignoreConfig --target ES2022 --module ESNext --moduleResolution Bundler --declaration --rewriteRelativeImportExtensions --types node --outDir dist src/edge.ts src/edge-caller.ts src/warmup-client.ts src/test/node.ts",
    "prepack": "bun run build:edge",
    "typecheck": "bun check",
    "smoke:bin": "node ./scripts/npm-cli.js --version",
    "prepublishOnly": "bun run build:edge && bun run typecheck && bun run smoke:bin"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.0",
    "drizzle-orm": "1.0.0-rc.4",
    "es-module-lexer": "^2",
    "esbuild": "^0.28.1",
    "hono": "^4.12.30"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.4",
    "@types/bun": "latest",
    "typescript": "^6"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
