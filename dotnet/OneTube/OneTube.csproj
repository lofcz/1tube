<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OneTube</RootNamespace>
    <PackageId>OneTube</PackageId>
    <Version>0.3.20</Version>
    <Authors>OneTube contributors</Authors>
    <Description>Host Supabase-compatible edge functions inside ASP.NET with zero-copy YARP proxying. The gateway runs on Bun (in-process or workerd backend); operator supplies explicit binary paths.</Description>
    <PackageProjectUrl>https://github.com/lofcz/1tube</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lofcz/1tube</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OneTube.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      We sit on top of ASP.NET Core (WebApplication, IHostedService,
      ILogger, IOptions, …) so we declare the framework reference
      explicitly. This keeps the package small (the framework is
      shared from the host) while letting the library compile in
      isolation for CI and `dotnet pack`.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <!--
      Read-only access to the gateway's invocation log store
      (SQLite + FTS5). The gateway owns the schema and migrations;
      the .NET side only ever issues SELECTs.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.*" />
  </ItemGroup>

  <!--
    Ship the 1tube TypeScript gateway sources as package content.
    Consumers (priprava, sciobot-next-host, …) must NOT need a sibling
    1tube checkout to run the gateway: restore/publish materializes
    OneTubeGateway/ next to the host output, and GatewayHostService
    resolves it via AppContext.BaseDirectory.
    package.json + bun.lock travel with the sources but node_modules does
    NOT (esbuild's binary is per-platform): on first start the host runs
    a frozen-lockfile, production-only `bun install` in OneTubeGateway/, so the
    gateway's own imports (hono, drizzle-orm, esbuild, …) resolve from
    OneTubeGateway/node_modules at the exact versions the lockfile pins.
    package.json is also where the gateway reads its version from;
    tsconfig.json carries the compiler options Bun applies to src/.
  -->
  <ItemGroup>
    <Content Include="..\..\src\**\*.ts"
             Exclude="..\..\src\**\*.test.ts">
      <Link>OneTubeGateway\src\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\OneTubeGateway\src\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
    </Content>
    <Content Include="..\..\package.json;..\..\bun.lock;..\..\tsconfig.json">
      <Link>OneTubeGateway\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\OneTubeGateway\%(Filename)%(Extension)</PackagePath>
    </Content>
    <!--
      SQL migrations for the invocation log store. Applied by the
      gateway at boot (drizzle migrator); must travel with src/.
    -->
    <Content Include="..\..\drizzle\**\*.*">
      <Link>OneTubeGateway\drizzle\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\OneTubeGateway\drizzle\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
    </Content>
    <None Include="buildTransitive\OneTube.targets"
          Pack="true"
          PackagePath="buildTransitive\OneTube.targets" />
    <None Include="..\..\README.md"
          Pack="true"
          PackagePath="\" />
  </ItemGroup>

</Project>
