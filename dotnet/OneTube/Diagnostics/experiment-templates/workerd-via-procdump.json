// Spawns workerd under SysInternals procdump. Procdump intercepts
// the unhandled exception that triggers std::terminate and writes
// a full memory dump BEFORE the process tears down — which WER
// would have done if HKCU\...\LocalDumps was writable.
//
// Setup (one-time, takes 30 seconds):
//   1) Download procdump from https://learn.microsoft.com/sysinternals/downloads/procdump
//   2) Extract procdump.exe (the 64-bit one) next to workerd.exe:
//      E:\www\sciobot.cz\Tools\OnetubeBin\procdump.exe
//
// Then run this experiment, run workerd-minimal (just to materialize
// the probe capnp if needed), then run this one again. Dumps land in
// ${DiagDir}\dumps as workerd_*.dmp — copy off the box, open in WinDbg.
{
  "id": "workerd-via-procdump",
  "name": "workerd minimal under procdump (full dump on crash)",
  "description": "Runs workerd-minimal as a child of procdump.exe. Captures a full crash dump without needing HKCU/HKLM WER access.",
  "executable": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
  "args": [
    "-NoProfile",
    "-NonInteractive",
    "-Command",
    "$ErrorActionPreference='Continue'; $w='${WorkerdPath}'; $probe='${ProbeCapnp}'; $diag='${DiagDir}'; $dumps=\"$diag\\dumps\"; New-Item -ItemType Directory -Force -Path $dumps | Out-Null; $procdump = Join-Path (Split-Path $w) 'procdump.exe'; if (-not (Test-Path $procdump)) { Write-Error \"procdump.exe not found at $procdump. Download SysInternals procdump and place procdump.exe next to workerd.exe.\"; exit 2 }; if (-not (Test-Path $probe)) { Write-Error \"probe capnp missing: $probe (run workerd-minimal once first to materialize it)\"; exit 3 }; Write-Host \"using procdump: $procdump\"; Write-Host \"dumps to: $dumps\"; & $procdump -accepteula -ma -e -x $dumps $w serve $probe 2>&1; Write-Host '== resulting dumps =='; Get-ChildItem $dumps -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 5 FullName, Length, LastWriteTime | Format-Table -AutoSize | Out-String"
  ],
  "cwd": "${DiagDir}",
  "timeoutSec": 30
}
